[sub_resource type="CSharpScript" id="CSharpScript_ms40e"]
script/source = "using Godot;
using System;

public partial class LaunchSequence : Node
{
	[Export] public float CountdownDuration { get; set; } = 10f;
	[Export] public RigidBody3D RocketBody;         // Direct drag-and-drop in the Inspector
	[Export] public AudioStreamPlayer AudioPlayer; // Direct drag-and-drop in the Inspector

	private float _currentTimer;
	private bool _isLaunching = false;
	private bool _sequenceStarted = false;

	public override void _Ready()
	{
		// Lock the rocket in place on the pad initially
		if (RocketBody != null)
		{
			RocketBody.LinearVelocity = Vector3.Zero;
		RocketBody.AngularVelocity = Vector3.Zero;
			RocketBody.Freeze = true;
		}
		else
		{
			GD.PrintErr(\"[LaunchSequence] ERROR: RocketBody is not assigned in the Inspector!\");
		}

		_currentTimer = CountdownDuration;
	}

	public override void _Process(double delta)
	{
		// Trigger the sequence with a keypress (e.g., Spacebar / ui_accept)
		if (!_sequenceStarted)
		{
			StartLaunchSequence();
		}

		// Handle the countdown loop
		if (_isLaunching)
		{
			_currentTimer -= (float)delta;

			if (_currentTimer <= 0f)
			{
				ReleaseRocket();
			}
		}
	}

	public void StartLaunchSequence()
	{
		_sequenceStarted = true;
		_isLaunching = true;
		_currentTimer = CountdownDuration;

		GD.Print(\"[LaunchSequence] Launch sequence initiated! T-Minus 10 seconds...\");

		// Play the ignition/countdown sound effect
		if (AudioPlayer != null)
		{
			AudioPlayer.Play();
		}
	}

	private void ReleaseRocket()
	{
		_isLaunching = false;

		// Unfreeze the rigid body so physics and thrust can take over
		if (RocketBody != null)
		{
			RocketBody.Freeze = false;
		}

		GD.Print(\"[LaunchSequence] Liftoff! Rocket is free to move.\");
	}
}
"

