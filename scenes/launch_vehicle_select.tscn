[sub_resource type="CSharpScript" id="CSharpScript_78k2i"]
script/source = "using Godot;

public partial class VABCameraManager : Camera3D
{
	[ExportGroup(\"Craft Hierarchy\")]
	[Export] public Node3D CraftRoot;

	[ExportGroup(\"Orbit Camera Settings\")]
	[Export] public float RotateSpeed = 150f;
	[Export] public float ZoomSpeed = 10f;
	[Export] public float MinDistance = 2f;
	[Export] public float MaxDistance = 35f;
	[Export] public float PanSmoothSpeed = 8f;

	private float _yaw = 0f;
	private float _pitch = 20f;
	private float _distance = 8f;

	private Vector3 _currentFocusPoint;
	private Vector3 _targetFocusPoint;
	private Vector2 _mouseDelta = Vector2.Zero;

	public override void _Ready()
	{
		Vector3 angles = RotationDegrees;
		_yaw = angles.Y;
		_pitch = angles.X;

		_currentFocusPoint = CraftRoot != null ? CraftRoot.GlobalPosition : Vector3.Zero;
		_targetFocusPoint = _currentFocusPoint;
	}

	public override void _Input(InputEvent @event)
	{
		if (@event is InputEventMouseMotion mouseMotion)
		{
			if (Input.IsMouseButtonPressed(MouseButton.Right) || Input.IsMouseButtonPressed(MouseButton.Middle))
			{
				_mouseDelta += mouseMotion.Relative;
			}
		}
		else if (@event is InputEventMouseButton mouseButton && mouseButton.Pressed)
		{
			if (mouseButton.ButtonIndex == MouseButton.WheelUp)
			{
				_distance -= ZoomSpeed * 0.2f;
			}
			else if (mouseButton.ButtonIndex == MouseButton.WheelDown)
			{
				_distance += ZoomSpeed * 0.2f;
			}
			_distance = Mathf.Clamp(_distance, MinDistance, MaxDistance);
		}
	}

	public override void _Process(double delta)
	{
		float fDelta = (float)delta;
		HandleFreeCameraInputs();
		UpdateCameraTransform(fDelta);
	}

	private void HandleFreeCameraInputs()
	{
		if (Input.IsMouseButtonPressed(MouseButton.Right))
		{
			_yaw -= _mouseDelta.X * (RotateSpeed * 0.001f);
			_pitch -= _mouseDelta.Y * (RotateSpeed * 0.001f);
			_pitch = Mathf.Clamp(_pitch, -80f, 80f);
		}

		if (Input.IsMouseButtonPressed(MouseButton.Middle))
		{
			float panX = -_mouseDelta.X * _distance * 0.0005f;
			float panY = _mouseDelta.Y * _distance * 0.0005f;
			Vector3 panDirection = GlobalTransform.Basis.X * panX + GlobalTransform.Basis.Y * panY;
			_targetFocusPoint += panDirection;
		}

		_mouseDelta = Vector2.Zero;
	}

	private void UpdateCameraTransform(float delta)
	{
		_currentFocusPoint = _currentFocusPoint.Lerp(_targetFocusPoint, delta * PanSmoothSpeed);

		Vector3 rotationAngles = new Vector3(Mathf.DegToRad(_pitch), Mathf.DegToRad(_yaw), 0f);
		Basis basis = Basis.FromEuler(rotationAngles);
		
		Vector3 negDistance = new Vector3(0f, 0f, _distance);
		Vector3 position = (basis * negDistance) + _currentFocusPoint;

		GlobalPosition = position;
		LookAt(_currentFocusPoint, Vector3.Up);
	}

	public void FocusOnPosition(Vector3 targetPos)
	{
		_targetFocusPoint = targetPos;
	}
	
	public void SetCraftRootPart(Node3D newCraftRootPart) 
	{
		CraftRoot = newCraftRootPart;
		if (CraftRoot != null)
		{
			FocusOnPosition(CraftRoot.GlobalPosition);
		}
	}
}
"

